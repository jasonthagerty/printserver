#!/command/with-contenv sh
# Creates or updates the print queue. Safe to run on every start: lpadmin -m
# re-copies the driver's PPD, so a driver upgrade in the image takes effect.
set -eu

i=0
# lpstat -r exits 0 either way; only its text says whether cupsd is up.
until lpstat -r 2>/dev/null | grep -q 'is running'; do
  i=$((i + 1))
  # Generous: a router's first boot from a USB drive is slow.
  if [ "$i" -gt 600 ]; then
    echo "cups-queue: cupsd did not start within 2 minutes" >&2
    exit 1
  fi
  sleep 0.2
done

queue="${PRINTSERVER_QUEUE:-MG3620}"
case "$PRINTSERVER_DEVICE" in
  test)
    uri="testfile:/"
    ;;
  usb)
    uri="$(lpinfo --include-schemes usb -v 2>/dev/null | awk '$2 ~ /^usb:\/\/Canon\// { print $2; exit }')"
    if [ -z "$uri" ]; then
      # The usb backend matches make and model, and holds jobs until the
      # printer appears.
      uri="usb://Canon/MG3600%20series"
      echo "cups-queue: no Canon printer on USB yet; jobs will wait for it" >&2
    fi
    ;;
esac

# The driver: by default the open Canon IVEC driver, which hands the printer
# sRGB pages so it does its own color and ends jobs the way Canon's driver
# does. Gutenprint is the fallback: its colors print dark, and its job ending
# makes the MG3620 feed a blank sheet after every job. PRINTSERVER_PPD
# overrides either.
case "${PRINTSERVER_DRIVER:-ivec}" in
  gutenprint) model="-m ${PRINTSERVER_PPD:-gutenprint.5.3://bjc-PIXMA-MG3620/expert}" ;;
  ivec) model="-P ${PRINTSERVER_PPD:-/usr/share/ppd/canon-ivec/Canon-MG3600_series-ivec.ppd}" ;;
  *)
    echo "cups-queue: PRINTSERVER_DRIVER must be gutenprint or ivec" >&2
    exit 1
    ;;
esac

# $model is two words on purpose
lpadmin -p "$queue" -E -v "$uri" $model \
  -D "${PRINTSERVER_PRINTER_INFO:-Canon MG3620}" \
  -L "${PRINTSERVER_LOCATION:-}" \
  -o printer-is-shared=true \
  -o PageSize="${PRINTSERVER_PAGE_SIZE:-Letter}" \
  -o printer-error-policy=retry-job
# Driver settings that should apply to every job (color tuning, for example
# "StpColorCorrection=Bright StpDensity=800"), from PRINTSERVER_PRINTER_OPTIONS.
for opt in ${PRINTSERVER_PRINTER_OPTIONS:-}; do
  case "$opt" in
    *=*) lpadmin -p "$queue" -o "$opt" && echo "cups-queue: default $opt" ;;
    *) echo "cups-queue: ignoring '$opt' in PRINTSERVER_PRINTER_OPTIONS (want Name=Value)" >&2 ;;
  esac
done
lpadmin -d "$queue"
cupsenable "$queue"
cupsaccept "$queue"
echo "cups-queue: $queue -> $uri (driver ${PRINTSERVER_DRIVER:-ivec})"
